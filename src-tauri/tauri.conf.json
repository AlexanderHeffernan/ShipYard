{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shipyard",
  "version": "0.1.0",
  "identifier": "com.alexanderheffernan.shipyard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Shipyard",
        "width": 800,
        "height": 600,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4MzlCNUFFQUJDNkE4NzcKUldSM3FNYXJyclU1NkxTNGtZZ1MxOVJtVmJBcm1pZFVtc2hrNlFrSHdUOTdrNEpzSzJwdHRrVTgK",
      "endpoints": [
        "https://github.com/alexanderheffernan/shipyard/releases/latest/download/latest.json"
      ]
    }
  }
}
