#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export DISPLAY="${DISPLAY:-:99}"

duration="${1:-10}"
output="${2:-.amp/in/artifacts/shipyard-$(date +%Y%m%d-%H%M%S).mp4}"
mkdir -p "$(dirname "$output")"
ffmpeg -loglevel warning -y -f x11grab -framerate 30 -video_size 1440x900 \
  -i "$DISPLAY.0" -t "$duration" -c:v libx264 -preset veryfast -pix_fmt yuv420p "$output"
printf '%s\n' "$output"
