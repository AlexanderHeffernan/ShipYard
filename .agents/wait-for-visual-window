#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:99}"
timeout_seconds="${1:-300}"
deadline=$((SECONDS + timeout_seconds))

while ((SECONDS < deadline)); do
  window="$(xdotool search --onlyvisible --name '^Shipyard$' 2>/dev/null | tail -1 || true)"
  if [[ -n "$window" ]]; then
    printf '%s\n' "$window"
    exit 0
  fi
  sleep 0.25
done

echo "Shipyard window did not appear on $DISPLAY within ${timeout_seconds}s." >&2
exit 1
