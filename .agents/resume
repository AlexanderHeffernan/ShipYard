#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$HOME/.cargo/bin:$PATH"

for command in node npm cargo rustc gh git zsh; do
  command -v "$command" >/dev/null || {
    echo "Missing prerequisite: $command (rerun .agents/setup)." >&2
    exit 1
  }
done

if [[ ! -d node_modules ]]; then
  echo "Missing JavaScript dependencies (rerun .agents/setup)." >&2
  exit 1
fi

echo "Shipyard orb prerequisites are ready."
