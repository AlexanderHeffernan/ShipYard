#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$HOME/.cargo/bin:$PATH"

for command in node npm cargo rustc ffmpeg gh git import openbox websockify wmctrl x11vnc xdotool xdpyinfo Xvfb zsh; do
  command -v "$command" >/dev/null || {
    echo "Missing prerequisite: $command (rerun .agents/setup)." >&2
    exit 1
  }
done

for helper in .agents/capture-recording .agents/capture-screenshot .agents/visual-service .agents/wait-for-visual-window; do
  [[ -x "$helper" ]] || {
    echo "Visual helper is not executable: $helper" >&2
    exit 1
  }
done

if [[ ! -d node_modules ]]; then
  echo "Missing JavaScript dependencies (rerun .agents/setup)." >&2
  exit 1
fi

echo "Shipyard orb prerequisites are ready."
